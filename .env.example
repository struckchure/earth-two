# Copy to .env and replace CHANGE_ME values. Real .env credentials stay untracked.
SKETCHFAB_API_KEY=CHANGE_ME_SKETCHFAB_KEY

# S3-compatible release storage
AWS_S3_ENDPOINT=https://CHANGE_ME.example.invalid
AWS_S3_REGION=CHANGE_ME_REGION
AWS_S3_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY
AWS_S3_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY
AWS_S3_BUCKET=CHANGE_ME_BUCKET
AWS_S3_PUBLIC_URL=https://CHANGE_ME.example.invalid
OTA_S3_PREFIX=earth-two

# Public database defaults compiled into desktop/web builds (no runtime .env).
SPACETIMEDB_SERVER=http://127.0.0.1:3001
SPACETIMEDB_DATABASE=earth-two
# Private release-publisher credential, never embedded in game clients.
SPACETIMEDB_PUBLISH_TOKEN=CHANGE_ME_PUBLISH_TOKEN
